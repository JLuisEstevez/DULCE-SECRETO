PORT=4000

# Cámbialo por cualquier texto largo y secreto antes de llevar esto a producción.
JWT_SECRET=cambia-este-secreto-por-uno-propio-y-largo

# Cuenta de administradora que se crea automáticamente la primera vez que arranca el servidor.
ADMIN_EMAIL_INICIAL=kelly@dulcesecreto.co
ADMIN_PASSWORD_INICIAL=dulcesecreto123

# Login social de clientes con Google. Créalo gratis en Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth Client ID > Web application).
# Debe ser EL MISMO valor que VITE_GOOGLE_CLIENT_ID en el .env del frontend.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
